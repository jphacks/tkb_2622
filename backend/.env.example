# Supabase project settings. SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are for
# the iOS Debug client; backend/compose.local.yaml does not read these two values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key

# JWT validation must use the same Supabase project as SUPABASE_URL.
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

AUTH_ALLOW_LOCAL_HTTP=false
